'use client';

import React, { useState, useEffect } from 'react';

export default function RecommendationsPage() {
  const [file, setFile] = useState<File | null>(null);
  const [loading, setLoading] = useState(false);
  const [detailTab, setDetailTab] = useState('overview');
  const [extractedSkills, setExtractedSkills] = useState<string[]>([]);
  const [recommendations, setRecommendations] = useState<any[]>([]);
  const [myApplications, setMyApplications] = useState<any[]>([]);
  const [stipendStats, setStipendStats] = useState<any[]>([]);

  const [candidateName, setCandidateName] = useState('Dheeraj S');
  const [candidateEmail, setCandidateEmail] = useState('dheeraj@pesu.edu');

  const [error, setError] = useState('');
  const [applyMsg, setApplyMsg] = useState('');
  const [searchTerm, setSearchTerm] = useState('');
  const [sortOrder, setSortOrder] = useState('high-low');
  const [typeFilter, setTypeFilter] = useState('all');
  const [modeFilter, setModeFilter] = useState('all');
  const [currentPage, setCurrentPage] = useState(1);
  const [savedOpportunityIds, setSavedOpportunityIds] = useState<Array<string | number>>([]);
  const [selectedOpportunity, setSelectedOpportunity] = useState<any | null>(null);

  const pageSize = 4;

  const getMatchPercent = (opportunity: any) => {
    const raw = Number(opportunity?.match_score ?? 0);
    if (!Number.isFinite(raw)) return 0;
    return Math.max(0, Math.min(100, raw <= 1 ? raw * 100 : raw));
  };

  const filteredRecommendations = recommendations
    .filter((rec: any) => {
      const haystack = [
        rec.title,
        rec.company_name,
        rec.description,
        rec.location,
        rec.opportunity_type,
        rec.mode,
        ...(Array.isArray(rec.skills) ? rec.skills : []),
      ]
        .filter(Boolean)
        .join(' ')
        .toLowerCase();

      const matchesSearch = haystack.includes(searchTerm.trim().toLowerCase());
      const type = String(rec.opportunity_type || rec.type || '').toLowerCase();
      const mode = String(rec.mode || rec.work_mode || '').toLowerCase();

      const matchesType = typeFilter === 'all' || type.includes(typeFilter);
      const matchesMode = modeFilter === 'all' || mode.includes(modeFilter);

      return matchesSearch && matchesType && matchesMode;
    })
    .sort((a: any, b: any) =>
      sortOrder === 'low-high'
        ? getMatchPercent(a) - getMatchPercent(b)
        : getMatchPercent(b) - getMatchPercent(a)
    );

  const totalPages = Math.max(1, Math.ceil(filteredRecommendations.length / pageSize));

  const visibleRecommendations = filteredRecommendations.slice(
    (currentPage - 1) * pageSize,
    currentPage * pageSize
  );

  const topMatchScore = recommendations.length
    ? Math.round(Math.max(...recommendations.map(getMatchPercent)))
    : 0;

  const fetchApplicationsForCandidate = async (emailToFetch: string) => {
    if (!emailToFetch.trim()) {
      setMyApplications([]);
      return;
    }

    try {
      const res = await fetch(
        `/api/applications?email=${encodeURIComponent(emailToFetch.trim())}`
      );

      const data = await res.json();

      if (data.success) {
        setMyApplications(data.applications || []);
        setStipendStats(data.stipend_analytics || []);
      }
    } catch (err) {
      console.error('Error fetching candidate applications:', err);
    }
  };

  useEffect(() => {
    fetchApplicationsForCandidate(candidateEmail);
  }, [candidateEmail]);

  const handleScanAndRecommend = async () => {
    if (!file) {
      setError('Please select a CV file first.');
      return;
    }

    setLoading(true);
    setError('');

    try {
      let cvText = '';

      if (file.type === 'application/pdf' || file.name.endsWith('.pdf')) {
        // eslint-disable-next-line @typescript-eslint/ban-ts-comment
        // @ts-ignore
        const pdfjsLib = await import('pdfjs-dist/build/pdf');

        pdfjsLib.GlobalWorkerOptions.workerSrc = '/pdf.worker.min.js';

        const arrayBuffer = await file.arrayBuffer();

        const pdf = await pdfjsLib.getDocument({
          data: new Uint8Array(arrayBuffer),
        }).promise;

        for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
          const page = await pdf.getPage(pageNum);
          const textContent = await page.getTextContent();

          cvText +=
            textContent.items
              .map((item: any) => ('str' in item ? item.str : ''))
              .join(' ') + '\n';
        }
      } else {
        cvText = await file.text();
      }

      if (!cvText.trim()) {
        throw new Error('No readable text found in the uploaded resume.');
      }

      const extractRes = await fetch('/api/extract-cv', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          cvText,
          fileName: file.name,
        }),
      });

      const extractData = await extractRes.json();

      if (!extractRes.ok || !extractData.success) {
        throw new Error(extractData.error || 'Skill extraction failed.');
      }

      const skills = extractData.extracted_skills || [];

      setExtractedSkills(skills);

      const saveRes = await fetch('/api/resumes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          fileName: file.name,
          extractedText: cvText,
          extractedSkills: skills,
        }),
      });

      const saveData = await saveRes.json();

      if (!saveRes.ok || !saveData.success) {
        throw new Error(saveData.error || 'Could not save your resume.');
      }

      // Recommendations are already generated by /api/extract-cv.
      // Do not call /api/opportunities here: its POST handler creates jobs.
      setRecommendations(extractData.recommendations || []);
      setCurrentPage(1);
    } catch (err: any) {
      console.error('Resume processing error:', err);
      setError(err.message || 'Something went wrong while processing your resume.');
    } finally {
      setLoading(false);
    }
  };

  const handleApply = async (opportunity: any) => {
    setApplyMsg('');

    try {
      const res = await fetch('/api/applications', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          opportunity_id: opportunity.opportunity_id,
          candidate_email: candidateEmail,
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Application could not be submitted.');
      }

      setApplyMsg('Application submitted successfully!');
      fetchApplicationsForCandidate(candidateEmail);
    } catch (err: any) {
      setApplyMsg(err.message || 'Unable to submit application.');
    }
  };

  const toggleSavedOpportunity = (id: string | number) => {
    setSavedOpportunityIds((current) =>
      current.includes(id)
        ? current.filter((savedId) => savedId !== id)
        : [...current, id]
    );
  };

  const skillCategories = [
    {
      name: 'Programming',
      icon: '⌘',
      skills: ['Python', 'Java', 'C', 'C++', 'JavaScript', 'TypeScript', 'React', 'Next.js', 'Node.js'],
    },
    {
      name: 'Databases',
      icon: '▤',
      skills: ['MySQL', 'PostgreSQL', 'MongoDB', 'Redis', 'Neo4j', 'SQL', 'ChromaDB'],
    },
    {
      name: 'AI / ML',
      icon: '✿',
      skills: ['Machine Learning', 'Deep Learning', 'PyTorch', 'TensorFlow', 'OpenCV', 'Data Analysis', 'Natural Language Processing'],
    },
    {
      name: 'Other Skills',
      icon: '★',
      skills: ['Git', 'Docker', 'Kubernetes', 'Linux', 'AWS', 'Communication'],
    },
  ];

  const groupedSkills = skillCategories
    .map((category) => ({
      ...category,
      skills: extractedSkills.filter((skill) =>
        category.skills.some(
          (knownSkill) => knownSkill.toLowerCase() === skill.toLowerCase()
        )
      ),
    }))
    .filter((category) => category.skills.length > 0);

  const unmatchedSkills = extractedSkills.filter(
    (skill) =>
      !skillCategories.some((category) =>
        category.skills.some(
          (knownSkill) => knownSkill.toLowerCase() === skill.toLowerCase()
        )
      )
  );

  const getOpportunityId = (opportunity: any) =>
    opportunity.opportunity_id ?? opportunity.id;

  const getSkillList = (opportunity: any): string[] => {
    if (Array.isArray(opportunity.skills)) return opportunity.skills;
    if (Array.isArray(opportunity.required_skills)) return opportunity.required_skills;
    return [];
  };

  const getCompanyInitial = (name: string) =>
    (name || 'C').trim().charAt(0).toUpperCase();

  const getMatchColor = (score: number) =>
    score >= 85 ? '#16d98a' : score >= 70 ? '#f5c542' : '#ff9b54';

  const getOpportunityStipend = (opportunity: any) =>
    opportunity.stipend || opportunity.stipend_amount || 'Not specified';

  const getOpportunityDuration = (opportunity: any) =>
    opportunity.duration || opportunity.duration_months || 'Not specified';

  const getOpportunityMode = (opportunity: any) =>
    opportunity.mode || opportunity.work_mode || 'Not specified';

  const getOpportunityType = (opportunity: any) =>
    opportunity.opportunity_type || opportunity.type || 'Internship';

  const getBreakdown = (opportunity: any) => {
    const score = getMatchPercent(opportunity);
    return {
      skill: Number(opportunity.skill_match ?? score),
      role: Number(opportunity.role_fit ?? score),
      domain: Number(opportunity.domain_fit ?? score),
    };
  };

  const totalSkillsMatched = extractedSkills.length;
    return (
    <main className="internhub-page">
      <style jsx global>{`
        * {
          box-sizing: border-box;
        }

        html {
          scroll-behavior: smooth;
        }

        body {
          margin: 0;
          background: #050817;
          color: #f8f9ff;
          font-family: Arial, Helvetica, sans-serif;
        }

        .internhub-page {
          min-height: 100vh;
          background:
            radial-gradient(ellipse at 75% 5%, rgba(104, 26, 220, 0.18), transparent 35%),
            radial-gradient(ellipse at 5% 35%, rgba(43, 66, 165, 0.10), transparent 35%),
            #050817;
          color: #f8f9ff;
          padding-bottom: 60px;
        }

        .ih-navbar {
          height: 72px;
          padding: 0 5%;
          display: flex;
          align-items: center;
          justify-content: space-between;
          border-bottom: 1px solid rgba(151, 75, 255, 0.35);
          background: rgba(5, 8, 23, 0.94);
          position: sticky;
          top: 0;
          z-index: 100;
          backdrop-filter: blur(16px);
        }

        .ih-brand {
          display: flex;
          align-items: center;
          gap: 12px;
          color: white;
          font-size: 25px;
          font-weight: 800;
          text-decoration: none;
          letter-spacing: -0.7px;
        }

        .ih-brand-icon {
          width: 36px;
          height: 36px;
          border: 2px solid #bd35ff;
          color: #d43cff;
          border-radius: 10px;
          display: grid;
          place-items: center;
          font-size: 25px;
          box-shadow: 0 0 18px rgba(190, 44, 255, 0.4);
        }

        .ih-navlinks {
          display: flex;
          align-items: center;
          gap: 30px;
          height: 100%;
        }

        .ih-navlinks a {
          height: 100%;
          display: flex;
          align-items: center;
          color: #c5c9dc;
          text-decoration: none;
          font-size: 14px;
          position: relative;
          transition: color 0.2s;
        }

        .ih-navlinks a:hover,
        .ih-navlinks a.active {
          color: white;
        }

        .ih-navlinks a.active::after {
          content: "";
          height: 3px;
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          background: #c32cff;
          box-shadow: 0 0 12px #c32cff;
        }

        .ih-profile {
          display: flex;
          align-items: center;
          gap: 10px;
          font-size: 13px;
          color: #e9e9f4;
        }

        .ih-avatar {
          height: 36px;
          width: 36px;
          display: grid;
          place-items: center;
          border-radius: 50%;
          background: linear-gradient(135deg, #8a36ff, #1e9be9);
          border: 2px solid #c45aff;
          font-weight: 700;
        }

        .ih-container {
          width: min(1240px, 92%);
          margin: 0 auto;
        }

        .ih-hero {
          min-height: 235px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          position: relative;
          overflow: hidden;
          padding: 32px 0 20px;
        }

        .ih-hero-copy {
          position: relative;
          z-index: 2;
          max-width: 690px;
        }

        .ih-eyebrow {
          color: #d45aff;
          font-size: 11px;
          font-weight: 800;
          letter-spacing: 2.5px;
          text-transform: uppercase;
          margin-bottom: 16px;
        }

        .ih-hero h1 {
          margin: 0 0 14px;
          font-size: clamp(32px, 4vw, 45px);
          line-height: 1.1;
          letter-spacing: -1.5px;
        }

        .ih-hero p {
          margin: 0;
          color: #c7cbe0;
          font-size: 16px;
          line-height: 1.6;
        }

        .ih-hero-art {
          width: 270px;
          height: 190px;
          object-fit: contain;
          filter: drop-shadow(0 0 25px rgba(145, 30, 255, 0.45));
          position: relative;
          z-index: 1;
        }

        .ih-progress {
          display: flex;
          align-items: center;
          justify-content: center;
          max-width: 760px;
          margin: 0 auto 32px;
        }

        .ih-progress-step {
          min-width: 120px;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 9px;
          text-align: center;
          font-size: 12px;
          font-weight: 700;
          color: #c6c9dd;
        }

        .ih-progress-number {
          width: 36px;
          height: 36px;
          display: grid;
          place-items: center;
          border-radius: 50%;
          border: 2px solid #777da6;
          background: #11182e;
          font-size: 16px;
        }

        .ih-progress-step.active .ih-progress-number,
        .ih-progress-step.done .ih-progress-number {
          background: linear-gradient(135deg, #a82cff, #7023ed);
          border-color: #e1aaff;
          box-shadow: 0 0 18px rgba(171, 45, 255, 0.65);
          color: white;
        }

        .ih-progress-line {
          height: 2px;
          flex: 1;
          max-width: 150px;
          background: linear-gradient(90deg, #9a34ff, #3c4268);
          margin: 0 12px;
          transform: translateY(-13px);
        }

        .ih-upload-grid {
          display: grid;
          grid-template-columns: 1.65fr 1fr;
          gap: 18px;
          align-items: stretch;
        }

        .ih-panel {
          background: linear-gradient(145deg, rgba(15, 24, 48, 0.96), rgba(9, 15, 32, 0.98));
          border: 1px solid rgba(91, 110, 164, 0.45);
          border-radius: 17px;
          padding: 20px;
          box-shadow: 0 12px 35px rgba(0, 0, 0, 0.18);
        }

        .ih-upload-panel {
          min-height: 390px;
        }

        .ih-dropzone {
          min-height: 230px;
          border: 2px dashed #bd4cff;
          border-radius: 15px;
          background: rgba(92, 32, 146, 0.10);
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          padding: 25px;
          cursor: pointer;
          transition: 0.2s ease;
        }

        .ih-dropzone:hover,
        .ih-dropzone.dragging {
          background: rgba(124, 45, 201, 0.2);
          border-color: #e17aff;
          box-shadow: inset 0 0 25px rgba(168, 46, 255, 0.12);
        }

        .ih-upload-icon {
          width: 62px;
          height: 62px;
          border-radius: 15px;
          background: linear-gradient(145deg, #29235b, #111c42);
          border: 1px solid #7049c9;
          display: grid;
          place-items: center;
          font-size: 32px;
          margin-bottom: 17px;
          color: #e2c9ff;
        }

        .ih-dropzone strong {
          font-size: 17px;
          margin-bottom: 8px;
        }

        .ih-dropzone span {
          color: #c4c9df;
          font-size: 13px;
        }

        .ih-file-input {
          display: none;
        }

        .ih-primary-button {
          border: 1px solid #c85aff;
          border-radius: 11px;
          color: white;
          background: linear-gradient(110deg, #a51eff, #7129e9);
          padding: 13px 24px;
          font-size: 14px;
          font-weight: 800;
          cursor: pointer;
          box-shadow: 0 5px 20px rgba(151, 37, 255, 0.3);
          transition: 0.2s ease;
        }

        .ih-primary-button:hover {
          transform: translateY(-2px);
          box-shadow: 0 8px 25px rgba(151, 37, 255, 0.48);
        }

        .ih-primary-button:disabled {
          opacity: 0.55;
          cursor: not-allowed;
          transform: none;
        }

        .ih-file-row {
          margin-top: 16px;
          padding: 13px 15px;
          min-height: 62px;
          border: 1px solid #35466e;
          border-radius: 12px;
          background: #101a32;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
        }

        .ih-file-info {
          display: flex;
          align-items: center;
          gap: 12px;
          min-width: 0;
        }

        .ih-pdf-icon {
          height: 40px;
          width: 35px;
          border-radius: 7px;
          background: white;
          color: #e52d45;
          display: grid;
          place-items: center;
          font-weight: 900;
          font-size: 11px;
          flex-shrink: 0;
        }

        .ih-file-name {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
          font-size: 13px;
          font-weight: 700;
        }

        .ih-file-size {
          font-size: 11px;
          color: #9ca9c7;
          margin-top: 5px;
        }

        .ih-remove-file {
          color: #c5cbe0;
          border: 0;
          background: transparent;
          font-size: 20px;
          cursor: pointer;
        }

        .ih-extract-wrap {
          display: flex;
          justify-content: center;
          margin-top: 16px;
        }

        .ih-extract-button {
          min-width: min(390px, 100%);
          font-size: 15px;
          padding: 15px 20px;
        }

        .ih-error {
          color: #ff8b9b;
          background: rgba(180, 35, 65, 0.12);
          border: 1px solid rgba(255, 90, 120, 0.35);
          border-radius: 9px;
          padding: 11px 13px;
          margin-top: 12px;
          font-size: 13px;
        }

        .ih-success {
          color: #39e99c;
          font-size: 12px;
        }

        .ih-side-column {
          display: flex;
          flex-direction: column;
          gap: 15px;
        }

        .ih-side-card {
          border-color: rgba(164, 59, 255, 0.75);
          padding: 19px;
        }

        .ih-side-card h3 {
          margin: 0 0 16px;
          font-size: 17px;
          padding-bottom: 12px;
          border-bottom: 1px solid rgba(116, 128, 173, 0.25);
        }

        .ih-how-item {
          display: flex;
          align-items: flex-start;
          gap: 13px;
          margin: 13px 0;
        }

        .ih-how-icon {
          height: 39px;
          width: 39px;
          flex-shrink: 0;
          border-radius: 50%;
          display: grid;
          place-items: center;
          background: linear-gradient(145deg, #9c29ed, #4c23ad);
          border: 1px solid #c17aff;
          box-shadow: 0 0 13px rgba(156, 41, 237, 0.3);
          font-size: 18px;
        }

        .ih-how-item strong {
          display: block;
          font-size: 13px;
          margin: 2px 0 5px;
        }

        .ih-how-item p {
          margin: 0;
          color: #b7bfd8;
          font-size: 11px;
          line-height: 1.5;
        }

        .ih-feature-list {
          list-style: none;
          padding: 0;
          margin: 0;
          display: grid;
          gap: 12px;
        }

        .ih-feature-list li {
          font-size: 12px;
          color: #d8dced;
        }

        .ih-feature-list li::before {
          content: "✓";
          color: #20e88c;
          font-size: 16px;
          font-weight: 900;
          margin-right: 10px;
        }

        .ih-section {
          margin-top: 20px;
          padding: 20px;
          border: 1px solid rgba(158, 59, 255, 0.7);
          border-radius: 17px;
          background: linear-gradient(145deg, rgba(14, 22, 44, 0.98), rgba(7, 13, 29, 0.98));
        }

        .ih-section-heading {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          border-bottom: 1px solid rgba(111, 126, 170, 0.25);
          padding-bottom: 13px;
          margin-bottom: 16px;
        }

        .ih-section-heading h2 {
          margin: 0;
          font-size: 20px;
        }

        .ih-muted {
          color: #aeb9d4;
          font-size: 12px;
        }

        .ih-skill-count {
          color: #c79aff;
          font-size: 26px;
          font-weight: 800;
          text-align: right;
        }

        .ih-skill-layout {
          display: grid;
          grid-template-columns: 145px 1fr;
          gap: 22px;
          align-items: center;
        }

        .ih-skill-ring {
          height: 125px;
          width: 125px;
          border-radius: 50%;
          display: grid;
          place-items: center;
          background: conic-gradient(#bd25ff 0deg, #6d31ee 260deg, #39236f 360deg);
          padding: 9px;
          box-shadow: 0 0 25px rgba(147, 42, 255, 0.2);
        }

        .ih-skill-ring-inner {
          width: 100%;
          height: 100%;
          border-radius: 50%;
          background: #0c142a;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
        }

        .ih-skill-ring-inner strong {
          font-size: 26px;
        }

        .ih-skill-ring-inner span {
          color: #c2c9dc;
          font-size: 10px;
          margin-top: 3px;
        }

        .ih-skill-groups {
          display: grid;
          gap: 13px;
        }

        .ih-skill-group {
          display: grid;
          grid-template-columns: 150px 1fr;
          gap: 12px;
          align-items: center;
        }

        .ih-skill-category {
          color: #e5e9f7;
          font-size: 12px;
          font-weight: 700;
        }

        .ih-skill-category span {
          color: #22d7ed;
          margin-right: 8px;
          font-size: 16px;
        }

        .ih-skill-chips {
          display: flex;
          flex-wrap: wrap;
          gap: 7px;
        }

        .ih-skill-chip {
          padding: 6px 10px;
          border: 1px solid #51428f;
          border-radius: 8px;
          background: rgba(76, 54, 145, 0.28);
          color: #e4e5fa;
          font-size: 11px;
        }

        @media (max-width: 850px) {
          .ih-upload-grid {
            grid-template-columns: 1fr;
          }

          .ih-hero-art {
            width: 210px;
          }

          .ih-navlinks {
            gap: 15px;
          }
        }

        @media (max-width: 600px) {
          .ih-navbar {
            padding: 0 4%;
          }

          .ih-brand {
            font-size: 19px;
          }

          .ih-navlinks {
            display: none;
          }

          .ih-hero {
            min-height: auto;
            padding: 35px 0 25px;
          }

          .ih-hero-art {
            display: none;
          }

          .ih-progress-step {
            min-width: 85px;
            font-size: 10px;
          }

          .ih-progress-line {
            margin: 0 4px;
          }

          .ih-skill-layout {
            grid-template-columns: 1fr;
            justify-items: center;
          }

          .ih-skill-group {
            grid-template-columns: 1fr;
            gap: 7px;
          }

          .ih-section-heading h2 {
            font-size: 17px;
          }
        }
      

          /* FULL JOB DETAILS VIEW */

          .ih-job-detail-overlay {
            position: fixed;
            inset: 0;
            z-index: 1000;
            overflow-y: auto;
            background: #050a17;
            padding: 20px;
          }

          .ih-job-detail-page {
            width: 100%;
            max-width: 1520px;
            min-height: calc(100vh - 40px);
            margin: 0 auto;
            padding: 25px 30px 35px;
            border: 2px solid #b832ff;
            border-radius: 22px;
            background:
              radial-gradient(ellipse at 75% 5%, rgba(91, 25, 173, 0.13), transparent 35%),
              linear-gradient(145deg, #071326, #050b18 65%, #080b20);
            box-shadow:
              0 0 15px rgba(191, 45, 255, 0.4),
              inset 0 0 25px rgba(127, 42, 255, 0.05);
            color: #f6f7ff;
          }

          .ih-back-jobs {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 25px;
            padding: 0;
            border: 0;
            background: transparent;
            color: #f5f5ff;
            font-size: 17px;
            font-weight: 800;
            cursor: pointer;
          }

          .ih-back-jobs:hover {
            color: #d45aff;
          }

          .ih-job-header {
            display: grid;
            grid-template-columns: 125px minmax(0, 1fr) 280px;
            align-items: center;
            gap: 25px;
            margin-bottom: 28px;
          }

          .ih-job-company-logo {
            width: 125px;
            height: 125px;
            display: grid;
            place-items: center;
            border-radius: 20px;
            background: #fff;
            color: #15192d;
            font-size: 45px;
            font-weight: 900;
            overflow: hidden;
          }

          .ih-job-company-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
          }

          .ih-job-heading h1 {
            margin: 0 0 12px;
            font-size: clamp(25px, 3vw, 39px);
            font-weight: 850;
            letter-spacing: -1px;
          }

          .ih-job-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 15px;
          }

          .ih-job-match-badge,
          .ih-job-featured-badge {
            padding: 9px 20px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 850;
          }

          .ih-job-match-badge {
            background: linear-gradient(120deg, #087c35, #08c75b);
            color: white;
            box-shadow: 0 0 15px rgba(0, 220, 100, 0.2);
          }

          .ih-job-featured-badge {
            background: linear-gradient(120deg, #087be8, #0754db);
            color: white;
          }

          .ih-job-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px 24px;
            color: #e4e8f6;
            font-size: 13px;
          }

          .ih-job-header-actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
          }

          .ih-job-apply-button {
            min-height: 58px;
            border: 1px solid #c34dff;
            border-radius: 13px;
            background: linear-gradient(110deg, #bd29ff, #721cff);
            color: white;
            font-size: 19px;
            font-weight: 850;
            cursor: pointer;
            box-shadow: 0 0 20px rgba(159, 40, 255, 0.25);
          }

          .ih-job-apply-button:hover {
            filter: brightness(1.15);
            transform: translateY(-1px);
          }

          .ih-job-save-button {
            min-height: 55px;
            border: 1px solid #8d8fc0;
            border-radius: 13px;
            background: #111b31;
            color: white;
            font-size: 17px;
            font-weight: 700;
            cursor: pointer;
          }

          .ih-job-save-button:hover,
          .ih-job-save-button.saved {
            border-color: #c34dff;
            color: #d86aff;
          }

          /* DETAIL TABS */

          .ih-job-tabs {
            display: flex;
            gap: 15px;
            align-items: stretch;
            border-bottom: 1px solid #526184;
            margin-bottom: 22px;
          }

          .ih-job-tabs button {
            min-width: 150px;
            padding: 15px 20px;
            border: 0;
            border-radius: 13px 13px 0 0;
            background: transparent;
            color: #e7e9f6;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
          }

          .ih-job-tabs button.active {
            background: linear-gradient(180deg, #211344, #28104c);
            color: white;
            box-shadow: 0 4px 0 #ad38ff, 0 0 15px rgba(171, 50, 255, 0.3);
          }

          .ih-job-tabs button:hover {
            color: #d76bff;
          }

          /* DETAIL CONTENT */

          .ih-job-detail-grid {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            gap: 20px;
            align-items: stretch;
          }

          .ih-job-detail-card {
            padding: 23px;
            border: 1px solid #8b83c2;
            border-radius: 19px;
            background: linear-gradient(135deg, #111d32, #081326);
            box-shadow: inset 0 0 20px rgba(95, 70, 150, 0.05);
          }

          .ih-job-detail-card h2 {
            margin: 0 0 16px;
            font-size: 22px;
            font-weight: 850;
          }

          .ih-job-description {
            color: #e3e6f3;
            font-size: 15px;
            line-height: 1.8;
            white-space: pre-line;
          }

          .ih-responsibilities-heading {
            margin-top: 32px !important;
          }

          .ih-responsibility-list {
            display: grid;
            gap: 15px;
            padding: 0;
            margin: 20px 0 0;
            list-style: none;
          }

          .ih-responsibility-list li {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            color: #edf0fb;
            font-size: 15px;
            line-height: 1.5;
          }

          .ih-responsibility-list li span {
            color: #a44dff;
            font-size: 19px;
          }

          .ih-job-detail-right {
            display: grid;
            align-content: start;
            gap: 16px;
          }

          .ih-detail-skill-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
          }

          .ih-detail-skill-list span {
            padding: 9px 16px;
            border: 1px solid #66739b;
            border-radius: 30px;
            background: linear-gradient(135deg, #293753, #18243d);
            color: #f5f6ff;
            font-size: 13px;
          }

          .ih-preferred-heading {
            margin-top: 23px !important;
          }

          .ih-detail-skill-list.preferred span {
            border-color: #9874d5;
            background: #211a3b;
          }

          /* MATCH ANALYSIS */

          .ih-match-analysis-content {
            display: flex;
            align-items: center;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 20px;
          }

          .ih-large-match-ring {
            width: 145px;
            height: 145px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 50%;
            padding: 12px;
          }

          .ih-large-match-ring > div {
            width: 100%;
            height: 100%;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #101a2e;
          }

          .ih-large-match-ring strong {
            font-size: 29px;
            font-weight: 900;
          }

          .ih-match-legend {
            display: grid;
            gap: 17px;
            flex: 1;
            min-width: 200px;
          }

          .ih-match-legend > div {
            display: grid;
            grid-template-columns: 14px 1fr auto;
            align-items: center;
            gap: 10px;
            font-size: 13px;
          }

          .ih-match-legend strong {
            font-size: 14px;
          }

          .ih-legend-dot {
            width: 13px;
            height: 13px;
            border-radius: 4px;
          }

          .ih-legend-dot.matched {
            background: #16e99b;
          }

          .ih-legend-dot.missing {
            background: #f13d73;
          }

          .ih-legend-dot.optional {
            background: #ffc400;
          }

          .ih-company-detail-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
            margin-top: 25px;
          }

          .ih-company-detail-grid > div,
          .ih-detail-item {
            display: flex;
            flex-direction: column;
            gap: 7px;
          }

          .ih-company-detail-grid span,
          .ih-detail-item span {
            color: #aab6d3;
            font-size: 12px;
          }

          .ih-company-detail-grid strong,
          .ih-detail-item strong {
            color: #f4f5ff;
            font-size: 14px;
          }

          .ih-requirement-score {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            margin-top: 30px;
          }

          .ih-requirement-score strong {
            color: #18e99c;
            font-size: 45px;
          }

          .ih-requirement-score span {
            color: #b9c5dd;
          }

          /* SAVED JOBS AND APPLICATIONS */

          .ih-extra-section {
            margin-top: 35px;
            padding: 23px;
            border: 1px solid #493c83;
            border-radius: 17px;
            background: linear-gradient(135deg, #10192e, #0a1021);
          }

          .ih-section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
          }

          .ih-section-heading h2 {
            margin: 0 0 6px;
            font-size: 21px;
          }

          .ih-extra-count {
            padding: 8px 14px;
            border: 1px solid #9b40eb;
            border-radius: 25px;
            color: #e5c8ff;
            background: #24133d;
            font-size: 12px;
            font-weight: 800;
          }

          .ih-saved-list {
            display: grid;
            gap: 10px;
          }

          .ih-saved-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            padding: 15px;
            border: 1px solid #334568;
            border-radius: 12px;
            background: #111c33;
          }

          .ih-saved-item p {
            margin: 6px 0 0;
          }

          .ih-saved-actions {
            display: flex;
            align-items: center;
            gap: 10px;
          }

          .ih-unsave-button {
            padding: 9px 12px;
            border: 1px solid #6b456e;
            border-radius: 8px;
            background: #21152d;
            color: #e8c9f6;
            cursor: pointer;
          }

          .ih-table-wrapper {
            overflow-x: auto;
          }

          .ih-application-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 13px;
          }

          .ih-application-table th,
          .ih-application-table td {
            padding: 14px 12px;
            border-bottom: 1px solid #293956;
          }

          .ih-application-table th {
            color: #c9a4ff;
            font-weight: 800;
          }

          .ih-status-pill {
            display: inline-block;
            padding: 6px 11px;
            border-radius: 20px;
            background: #163c35;
            color: #48e5a9;
            font-size: 11px;
            font-weight: 800;
          }

          .ih-stipend-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 13px;
          }

          .ih-stipend-card {
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 18px;
            border: 1px solid #54418e;
            border-radius: 13px;
            background: #15152e;
          }

          .ih-stipend-card span,
          .ih-stipend-card small {
            color: #b5c0dc;
          }

          .ih-stipend-card strong {
            color: #dba4ff;
            font-size: 22px;
          }

          .ih-application-feedback {
            position: fixed;
            right: 25px;
            bottom: 25px;
            z-index: 1200;
            max-width: 400px;
            padding: 15px 20px;
            border: 1px solid #22d99a;
            border-radius: 12px;
            background: #102b28;
            color: #a9ffdc;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.4);
          }

          .ih-application-feedback button {
            margin-left: 15px;
            border: 0;
            background: transparent;
            color: white;
            font-size: 18px;
            cursor: pointer;
          }

          /* RESPONSIVE */

          @media (max-width: 1000px) {
            .ih-job-header {
              grid-template-columns: 95px minmax(0, 1fr);
            }

            .ih-job-company-logo {
              width: 95px;
              height: 95px;
            }

            .ih-job-header-actions {
              grid-column: 1 / -1;
              flex-direction: row;
            }

            .ih-job-header-actions button {
              flex: 1;
            }

            .ih-job-detail-grid {
              grid-template-columns: 1fr;
            }
          }

          @media (max-width: 600px) {
            .ih-job-detail-overlay {
              padding: 7px;
            }

            .ih-job-detail-page {
              padding: 18px 13px;
              border-radius: 14px;
            }

            .ih-job-header {
              grid-template-columns: 65px minmax(0, 1fr);
              gap: 13px;
            }

            .ih-job-company-logo {
              width: 65px;
              height: 65px;
              border-radius: 12px;
              font-size: 25px;
            }

            .ih-job-heading h1 {
              font-size: 21px;
            }

            .ih-job-meta {
              font-size: 11px;
              gap: 9px;
            }

            .ih-job-header-actions {
              grid-column: 1 / -1;
            }

            .ih-job-tabs {
              gap: 2px;
            }

            .ih-job-tabs button {
              min-width: 0;
              flex: 1;
              padding: 12px 5px;
              font-size: 12px;
            }

            .ih-job-detail-card {
              padding: 17px;
            }

            .ih-job-detail-card h2 {
              font-size: 19px;
            }

            .ih-match-analysis-content {
              flex-direction: column;
            }

            .ih-match-legend {
              width: 100%;
            }

            .ih-company-detail-grid {
              grid-template-columns: 1fr;
            }
          }
        


          .ih-recommendation-section {
            margin-top: 45px;
          }

          .ih-recommendation-hero {
            position: relative;
            min-height: 155px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            overflow: hidden;
            padding: 20px 5px;
          }

          .ih-recommendation-hero h2 {
            font-size: clamp(28px, 3vw, 38px);
            margin: 0 0 10px;
            letter-spacing: -1px;
          }

          .ih-recommendation-hero p {
            color: #bfc6dd;
            margin: 0;
            font-size: 15px;
          }

          .ih-recommendation-art {
            width: 220px;
            height: 150px;
            object-fit: contain;
            filter: drop-shadow(0 0 22px rgba(132, 40, 255, 0.5));
          }

          .ih-stat-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 13px;
            margin: 5px 0 24px;
            max-width: 880px;
          }

          .ih-stat-card {
            min-height: 76px;
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 13px 17px;
            border: 1px solid rgba(147, 68, 255, 0.55);
            border-radius: 13px;
            background: linear-gradient(135deg, #11172e, #10102b);
          }

          .ih-stat-icon {
            font-size: 29px;
            color: #bd42ff;
          }

          .ih-stat-value {
            font-size: 23px;
            font-weight: 800;
          }

          .ih-stat-label {
            font-size: 11px;
            color: #c2c9dd;
            margin-top: 3px;
          }

          .ih-filter-bar {
            display: grid;
            grid-template-columns: minmax(180px, 1fr) repeat(3, auto) auto;
            gap: 10px;
            margin: 20px 0 22px;
          }

          .ih-search-box,
          .ih-filter-select,
          .ih-reset-button {
            height: 43px;
            border: 1px solid #46547d;
            border-radius: 10px;
            background: #101a32;
            color: #f4f5ff;
            padding: 0 13px;
            font-size: 12px;
            outline: none;
          }

          .ih-search-box:focus,
          .ih-filter-select:focus {
            border-color: #bd43ff;
            box-shadow: 0 0 0 2px rgba(189, 67, 255, 0.13);
          }

          .ih-search-box {
            width: 100%;
          }

          .ih-search-box::placeholder {
            color: #aab4ce;
          }

          .ih-filter-select {
            cursor: pointer;
            min-width: 105px;
          }

          .ih-filter-select option {
            background: #101a32;
            color: white;
          }

          .ih-reset-button {
            cursor: pointer;
            font-weight: 700;
          }

          .ih-reset-button:hover {
            border-color: #bd43ff;
          }

          .ih-opportunity-list {
            display: grid;
            gap: 12px;
          }

          .ih-opportunity-card {
            display: grid;
            grid-template-columns: 55px minmax(180px, 1.3fr) 85px minmax(190px, 1fr) 105px;
            align-items: center;
            gap: 15px;
            min-height: 125px;
            padding: 16px;
            border: 1px solid #293b62;
            border-radius: 15px;
            background: linear-gradient(110deg, #111a31, #0c1429);
            transition: 0.2s ease;
          }

          .ih-opportunity-card:hover {
            border-color: #9042e9;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(78, 31, 145, 0.18);
          }

          .ih-company-logo {
            height: 52px;
            width: 52px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: #fff;
            color: #20243b;
            font-size: 23px;
            font-weight: 900;
            overflow: hidden;
          }

          .ih-company-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
          }

          .ih-opportunity-info {
            min-width: 0;
          }

          .ih-opportunity-info h3 {
            margin: 0 0 5px;
            font-size: 15px;
            line-height: 1.35;
          }

          .ih-company-name {
            color: #d4d9eb;
            font-size: 12px;
            margin-bottom: 10px;
          }

          .ih-opportunity-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            color: #b9c2da;
            font-size: 10px;
            margin-bottom: 10px;
          }

          .ih-opportunity-skills {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
          }

          .ih-opportunity-skill {
            border: 1px solid #42517b;
            background: #1b2748;
            color: #e3e8fb;
            border-radius: 7px;
            padding: 5px 8px;
            font-size: 10px;
          }

          .ih-match-column {
            display: flex;
            justify-content: center;
            border-left: 1px solid rgba(111, 130, 176, 0.25);
            border-right: 1px solid rgba(111, 130, 176, 0.25);
            padding: 0 8px;
          }

          .ih-match-ring {
            width: 66px;
            height: 66px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            padding: 6px;
          }

          .ih-match-ring-inner {
            height: 100%;
            width: 100%;
            border-radius: 50%;
            background: #10182e;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
          }

          .ih-match-ring-inner strong {
            font-size: 16px;
          }

          .ih-match-ring-inner span {
            color: #27df9a;
            font-size: 9px;
          }

          .ih-breakdown {
            min-width: 0;
          }

          .ih-breakdown-title {
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 10px;
          }

          .ih-breakdown-row {
            display: grid;
            grid-template-columns: 62px minmax(35px, 1fr) 32px;
            align-items: center;
            gap: 7px;
            margin: 8px 0;
            font-size: 10px;
            color: #d6dced;
          }

          .ih-progress-track {
            height: 7px;
            border-radius: 20px;
            overflow: hidden;
            background: #293653;
          }

          .ih-progress-fill {
            height: 100%;
            border-radius: 20px;
          }

          .ih-card-actions {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
          }

          .ih-save-button {
            align-self: flex-end;
            background: transparent;
            border: none;
            color: #e7eafa;
            font-size: 23px;
            cursor: pointer;
            line-height: 1;
          }

          .ih-save-button.saved {
            color: #d04cff;
          }

          .ih-view-button {
            padding: 10px 9px;
            border-radius: 9px;
            background: linear-gradient(110deg, #a020ff, #6426e8);
            border: 1px solid #a74cff;
            color: white;
            font-weight: 800;
            font-size: 11px;
            cursor: pointer;
            white-space: nowrap;
          }

          .ih-view-button:hover {
            box-shadow: 0 0 16px rgba(159, 39, 255, 0.4);
          }

          .ih-empty-state {
            text-align: center;
            padding: 45px 20px;
            border: 1px dashed #505c85;
            border-radius: 14px;
            color: #bbc4dc;
          }

          .ih-pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin: 30px 0 15px;
          }

          .ih-page-button {
            min-width: 37px;
            height: 37px;
            border-radius: 9px;
            background: #101a32;
            border: 1px solid #35466d;
            color: white;
            cursor: pointer;
          }

          .ih-page-button.active {
            background: linear-gradient(135deg, #a529ff, #6c24e8);
            border-color: #c35cff;
            box-shadow: 0 0 15px rgba(157, 42, 255, 0.3);
          }

          .ih-page-button:disabled {
            opacity: 0.35;
            cursor: not-allowed;
          }

          @media (max-width: 950px) {
            .ih-opportunity-card {
              grid-template-columns: 48px minmax(150px, 1fr) 75px minmax(150px, 1fr);
            }

            .ih-card-actions {
              grid-column: 2 / -1;
              flex-direction: row;
              justify-content: flex-end;
            }

            .ih-save-button {
              align-self: center;
            }

            .ih-filter-bar {
              grid-template-columns: 1fr 1fr;
            }

            .ih-search-box {
              grid-column: 1 / -1;
            }
          }

          @media (max-width: 600px) {
            .ih-recommendation-art {
              display: none;
            }

            .ih-stat-grid {
              grid-template-columns: 1fr;
            }

            .ih-filter-bar {
              grid-template-columns: 1fr 1fr;
            }

            .ih-opportunity-card {
              grid-template-columns: 48px 1fr 70px;
              gap: 10px;
            }

            .ih-breakdown {
              grid-column: 1 / -1;
              padding-top: 12px;
              border-top: 1px solid rgba(111, 130, 176, 0.25);
            }

            .ih-card-actions {
              grid-column: 1 / -1;
            }

            .ih-match-column {
              border-right: none;
            }
          }

/* INTERNHUB_REFERENCE_SCALE_V1 */

.ih-navbar {
height: 94px;
padding-inline: 3.6%;
}

.ih-brand {
font-size: clamp(27px, 2vw, 34px);
gap: 15px;
}

.ih-brand-icon {
width: 52px;
height: 52px;
font-size: 31px;
border-radius: 13px;
}

.ih-navlinks {
gap: clamp(25px, 3.2vw, 60px);
}

.ih-navlinks a {
font-size: clamp(17px, 1.25vw, 22px);
}

.ih-profile {
font-size: 19px;
gap: 14px;
}

.ih-avatar {
width: 62px;
height: 62px;
font-size: 24px;
}

.ih-container {
width: min(1760px, 93.5%);
max-width: none;
}

.ih-hero {
min-height: 275px;
padding: 45px 12px 28px;
}

.ih-hero-copy {
max-width: 980px;
}

.ih-eyebrow {
font-size: 15px;
letter-spacing: 3.5px;
margin-bottom: 20px;
}

.ih-hero h1 {
font-size: clamp(44px, 4.1vw, 68px);
line-height: 1.08;
letter-spacing: -2px;
margin-bottom: 16px;
}

.ih-hero p {
font-size: clamp(19px, 1.65vw, 27px);
line-height: 1.5;
}

.ih-hero-art {
width: clamp(300px, 28vw, 470px);
height: 260px;
margin-right: 20px;
}

.ih-progress {
max-width: 900px;
margin-bottom: 42px;
}

.ih-progress-step {
min-width: 155px;
gap: 12px;
font-size: 16px;
}

.ih-progress-number {
width: 44px;
height: 44px;
font-size: 19px;
}

.ih-progress-line {
max-width: 190px;
margin-inline: 16px;
}

.ih-upload-grid {
grid-template-columns: minmax(0, 1.65fr) minmax(360px, 1fr);
gap: 24px;
}

.ih-panel {
padding: 25px;
border-radius: 20px;
}

.ih-upload-panel {
min-height: 500px;
}

.ih-dropzone {
min-height: 310px;
padding: 35px;
border-radius: 18px;
}

.ih-upload-icon {
width: 76px;
height: 76px;
font-size: 38px;
margin-bottom: 20px;
}

.ih-dropzone strong {
font-size: 24px;
}

.ih-dropzone span {
font-size: 17px;
}

.ih-primary-button {
padding: 16px 30px;
font-size: 18px;
border-radius: 13px;
}

.ih-extract-button {
min-width: min(470px, 100%);
font-size: 19px;
padding: 18px 25px;
}

.ih-file-row {
min-height: 76px;
padding: 16px 19px;
}

.ih-file-name {
font-size: 17px;
}

.ih-file-size {
font-size: 14px;
}

.ih-side-column {
gap: 20px;
}

.ih-side-card {
padding: 25px;
}

.ih-side-card h3 {
font-size: 25px;
margin-bottom: 20px;
}

.ih-how-item {
gap: 17px;
margin: 19px 0;
}

.ih-how-icon {
width: 48px;
height: 48px;
font-size: 22px;
}

.ih-how-item strong {
font-size: 18px;
}

.ih-how-item p {
font-size: 15px;
line-height: 1.6;
}

.ih-feature-list {
gap: 17px;
}

.ih-feature-list li {
font-size: 16px;
}

.ih-section {
margin-top: 26px;
padding: 26px;
border-radius: 20px;
}

.ih-section-heading h2 {
font-size: 27px;
}

.ih-muted {
font-size: 15px;
}

.ih-skill-layout {
grid-template-columns: 190px 1fr;
gap: 30px;
}

.ih-skill-ring {
width: 170px;
height: 170px;
}

.ih-skill-ring-inner strong {
font-size: 35px;
}

.ih-skill-ring-inner span {
font-size: 14px;
}

.ih-skill-groups {
gap: 18px;
}

.ih-skill-group {
grid-template-columns: 180px 1fr;
gap: 18px;
}

.ih-skill-category {
font-size: 16px;
}

.ih-skill-chip {
padding: 9px 15px;
font-size: 14px;
border-radius: 11px;
}

/* RECOMMENDATION HERO AND METRICS */

.ih-recommendation-section {
margin-top: 55px;
}

.ih-recommendation-hero {
min-height: 235px;
padding: 30px 18px 22px;
}

.ih-recommendation-hero h2 {
font-size: clamp(43px, 4vw, 66px);
line-height: 1.08;
letter-spacing: -2px;
margin-bottom: 16px;
}

.ih-recommendation-hero p {
font-size: clamp(19px, 1.6vw, 26px);
line-height: 1.5;
}

.ih-recommendation-art {
width: clamp(330px, 29vw, 490px);
height: 255px;
}

.ih-stat-grid {
max-width: 1140px;
gap: 20px;
margin: 10px 0 35px;
}

.ih-stat-card {
min-height: 132px;
gap: 22px;
padding: 22px 28px;
border-radius: 20px;
}

.ih-stat-icon {
font-size: 48px;
}

.ih-stat-value {
font-size: 43px;
line-height: 1.1;
}

.ih-stat-label {
font-size: 18px;
margin-top: 8px;
}

/* SEARCH AND FILTER CONTROLS */

.ih-filter-bar {
grid-template-columns: minmax(300px, 1fr) repeat(3, auto) auto;
gap: 17px;
margin: 28px 0 35px;
}

.ih-search-box,
.ih-filter-select,
.ih-reset-button {
height: 76px;
border-radius: 18px;
padding-inline: 23px;
font-size: 19px;
border-width: 1.5px;
}

.ih-filter-select {
min-width: 175px;
}

.ih-reset-button {
min-width: 155px;
font-size: 19px;
}

/* INTERNSHIP CARDS */

.ih-opportunity-list {
gap: 18px;
}

.ih-opportunity-card {
grid-template-columns: 72px minmax(230px, 1.3fr) 112px minmax(230px, 1fr) 140px;
gap: 21px;
min-height: 165px;
padding: 23px;
border-radius: 19px;
}

.ih-company-logo {
width: 66px;
height: 66px;
border-radius: 15px;
font-size: 29px;
}

.ih-opportunity-info h3 {
font-size: 20px;
margin-bottom: 8px;
}

.ih-company-name {
font-size: 16px;
margin-bottom: 12px;
}

.ih-opportunity-meta {
gap: 15px;
font-size: 13px;
margin-bottom: 12px;
}

.ih-opportunity-skill {
padding: 7px 11px;
font-size: 12px;
border-radius: 9px;
}

.ih-match-ring {
width: 88px;
height: 88px;
padding: 7px;
}

.ih-match-ring-inner strong {
font-size: 21px;
}

.ih-match-ring-inner span {
font-size: 11px;
}

.ih-breakdown-title {
font-size: 15px;
margin-bottom: 12px;
}

.ih-breakdown-row {
grid-template-columns: 76px minmax(45px, 1fr) 38px;
gap: 9px;
margin: 10px 0;
font-size: 12px;
}

.ih-progress-track {
height: 9px;
}

.ih-view-button {
padding: 14px 12px;
font-size: 14px;
border-radius: 11px;
}

.ih-save-button {
font-size: 27px;
}

.ih-empty-state {
padding: 65px 25px;
font-size: 18px;
}

.ih-page-button {
min-width: 45px;
height: 45px;
font-size: 15px;
}

/* JOB DETAILS */

.ih-job-detail-page {
max-width: 1700px;
padding: 32px 40px 45px;
}

.ih-job-heading h1 {
font-size: clamp(34px, 3vw, 48px);
}

.ih-job-detail-card {
padding: 30px;
}

.ih-job-detail-card h2 {
font-size: 27px;
}

.ih-job-description,
.ih-responsibility-list li {
font-size: 17px;
}

/* TABLET */

@media (max-width: 1100px) {
.ih-navbar {
padding-inline: 3%;
}

.ih-navlinks {
gap: 18px;
}

.ih-navlinks a {
font-size: 14px;
}

.ih-container {
width: 94%;
}

.ih-upload-grid {
grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
}

.ih-opportunity-card {

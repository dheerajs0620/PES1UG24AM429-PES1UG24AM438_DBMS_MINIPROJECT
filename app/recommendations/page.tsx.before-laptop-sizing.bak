        /* INTERNHUB_RECOMMENDATIONS_HERO_FINAL */

        .ih-recommendation-section {
          width: 100%;
          margin-top: 38px;
        }

        .ih-recommendation-hero {
          min-height: 270px;
          padding: 20px 18px 25px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 25px;
        }

        .ih-recommendation-hero > div:first-child {
          flex: 1;
          min-width: 0;
        }

        .ih-recommendation-hero h2 {
          font-size: clamp(48px, 4.8vw, 72px);
          line-height: 1.08;
          font-weight: 850;
          letter-spacing: -2.5px;
          margin: 0 0 18px;
          color: #f8f9ff;
        }

        .ih-recommendation-hero p {
          font-size: clamp(19px, 1.8vw, 28px);
          line-height: 1.5;
          color: #d5dcf1;
          margin: 0;
          white-space: nowrap;
        }

        .ih-recommendation-art {
          display: block;
          flex: 0 0 auto;
          width: clamp(390px, 32vw, 610px);
          height: 360px;
          object-fit: contain;
          object-position: center;
          mix-blend-mode: screen;
          filter: drop-shadow(0 0 25px rgba(132, 40, 255, .38));
        }

        .ih-stat-grid {
          width: min(100%, 1120px);
          max-width: 1120px;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 22px;
          margin: 5px 0 36px 16px;
        }

        .ih-stat-card {
          min-height: 132px;
          padding: 22px 28px;
          gap: 23px;
          border: 1.5px solid #963df2;
          border-radius: 21px;
          background: linear-gradient(125deg, #11172f, #090d20);
          box-shadow: inset 0 0 20px rgba(117, 61, 220, .045);
        }

        .ih-stat-icon {
          min-width: 70px;
          font-size: 58px;
          line-height: 1;
          color: #d33cff;
          text-shadow: 0 0 20px rgba(188, 55, 255, .65);
        }

        .ih-stat-card:nth-child(2) .ih-stat-icon {
          color: #00d9ff;
          text-shadow: 0 0 20px rgba(0, 217, 255, .6);
        }

        .ih-stat-card:nth-child(3) .ih-stat-icon {
          color: #ffd21c;
          text-shadow: 0 0 20px rgba(255, 210, 28, .5);
        }

        .ih-stat-value {
          font-size: 44px;
          line-height: 1.05;
          font-weight: 850;
          color: #fff;
        }

        .ih-stat-label {
          font-size: 18px;
          font-weight: 600;
          margin-top: 9px;
          color: #f0f1fa;
          white-space: nowrap;
        }

        .ih-filter-bar {
          width: 100%;
          grid-template-columns: minmax(280px, 1fr) 1.05fr .58fr .58fr auto;
          gap: 17px;
          margin: 30px 0 38px;
        }

        .ih-search-box,
        .ih-filter-select,
        .ih-reset-button {
          height: 76px;
          border: 1.5px solid #667fc1;
          border-radius: 19px;
          background: linear-gradient(120deg, #111a33, #10152a);
          color: #f7f8ff;
          padding: 0 23px;
          font-size: 19px;
          font-weight: 650;
        }

        .ih-search-box::placeholder {
          color: #d1d9ef;
          opacity: 1;
        }

        .ih-filter-select {
          min-width: 0;
          cursor: pointer;
        }

        .ih-reset-button {
          min-width: 155px;
          cursor: pointer;
        }

        .ih-opportunity-list {
          gap: 19px;
        }

        @media (min-width: 1500px) {
          .ih-recommendation-hero {
